# The two locations of a run (SET ME). run.sh reads this file; environment variables of the same names override it.
# Each may live anywhere (fast local disk preferred for the data); they are independent of this folder.
VM_DATA_DIR=/path/to/data       # the dataset goes to $VM_DATA_DIR/RubikMemory/ (~75 GB: 60,448 latent files + meta)
VM_OUT_DIR=/path/to/outputs     # every run's outputs, logs, summary and the hand-back staging (~110 GB at peak)
